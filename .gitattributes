.gitattributes export-ignore

# Normalise line endings so Windows and Linux contributors see the same
# bytes in the repo. Working copies get native line endings on checkout;
# the repo stores LF.
* text=auto eol=lf

# Explicitly binary (no line-ending translation).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pdf binary

