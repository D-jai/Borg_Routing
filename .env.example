# BORG_ROUTE environment variables
# Copy to .env and fill in values you intend to use.

# --- OpenRouter ----------------------------------------------------------
# API key for OpenRouter. Used by:
#   - discovery (higher rate limits when authed)
#   - the scorer (Get Model Info button) as the default scoring_api_key
#   - any orchestrator/answerer call to an openrouter/* model
OPENROUTER_API_KEY=

# OpenRouter attribution (optional; shows up on the OpenRouter dashboard).
OPENROUTER_APP_URL=https://github.com/D-jai/Borg_Routing
OPENROUTER_APP_NAME=BORG_ROUTE

# --- Payload caps --------------------------------------------------------
# OpenAI-compatible providers default to 0 tokens when max_tokens is absent,
# and OpenRouter in particular rejects that with HTTP 402. These caps are sent
# on every orchestrator and answerer call.
#
# BRT-ANS-009 — On the answerer path, ANSWERER_MAX_TOKENS is treated as a
# FLOOR. A plan node that sets a higher per-envelope `max_output_tokens`
# (schema default 4000) will get the larger cap; the env var only kicks in
# when the envelope asks for less. Both the answerer AND the orchestrator
# now auto-retry once with the cap doubled (ceiling 16k) on
# finish_reason=='length' so silent truncation no longer cascades into
# BRT-ANS-004 / BRT-ORC-002.
#
# What 6000 does: a plain model may write up to 6000 tokens per call and is
# retried once at 12000 if cut off. A reasoning-family model gets 4x the cap
# (so 6000 -> 24000), which is already above the 16000 retry ceiling, so a
# reasoning model gets no retry at these values. Unset, the code default is
# 2000 (reasoning models 8000, retried at 16000).
ORCHESTRATOR_MAX_TOKENS=6000
ANSWERER_MAX_TOKENS=6000

# --- Router knobs --------------------------------------------------------
# How much a second of model latency costs in USD. Default is tuned for a
# single developer running locally; bump to 0.0083 (~$30/hr) for SaaS.
# Writes to the `time_cost_per_sec` config key (via POST /config) win over
# this; the Admin UI shows the effective value with a source hint.
TIME_COST_PER_SEC=0.0001

# Minimum task_score the orchestrator model must meet. The orchestrator IS the
# brain of every run — a mid-tier brain produces mid-tier plans. 9.0 forces a
# frontier-or-near-frontier model to take the reins. Six of the curated
# OpenRouter rows already meet this bar out of the box (claude-opus-4.7,
# gpt-5.4-pro, grok-4.20, kimi-k2-thinking, claude-sonnet-4.6, gemini-3.1-pro).
# The orchestrator will degrade gracefully (BRT-ORC-NO-FRONTIER trace event)
# if no checked model meets 9.0 — but you'll feel the quality drop.
ORCHESTRATOR_QUALITY_REQUIREMENT=9.0

# --- Per-step quality floors ---------------------------------------------
# Every step in a plan is routed on its own: the cheapest ticked model whose
# score for the step's kind of work is at or above the floor of the step's
# tier (light, mid, heavy). Lower a floor to let cheaper or local models take
# that tier; raise it to keep them out. Config keys `leaf_quality_light`,
# `leaf_quality_mid`, `leaf_quality_heavy` win over these values.
LEAF_QUALITY_LIGHT=6.0
LEAF_QUALITY_MID=7.5
LEAF_QUALITY_HEAVY=9.0

# --- Baseline model for cost comparison ----------------------------------
# The model the receipt's one-pass floor ("direct_floor_dollars": "One pass on <model>:
# at least US$X") is priced on, and the model the router prices each step on for its
# estimate. Leave unset to use the checked model with the highest
# `reasoning` score. Config key `baseline_model_id` wins over this value.
# BASELINE_MODEL_ID=

# --- Wall-clock budget (BRT-PIP-008) -------------------------------------
# Hard ceiling on how long any single run may take (seconds). On timeout
# the run is cancelled, marked `failed`, and returns a readable error to
# the caller. Default 300s (5 minutes). Writes to the `max_run_seconds`
# config key win; the Admin UI shows the effective value with a source
# hint. Raise this for legitimately long research / compose tasks.
BORG_MAX_RUN_SECONDS=500

# --- Per-call model timeouts (seconds) ------------------------------------
# How long one answerer (step) call or one orchestrator (plan, re_plan,
# compose) call may take before it fails (BRT-ANS-006 / BRT-ORC-001). Read
# at each call; an invalid value falls back to the default with a warning.
# Defaults 120 and 180. The bench sets both to 7200 for its runs only.
# BORG_ANSWERER_CALL_TIMEOUT=120
# BORG_ORCHESTRATOR_CALL_TIMEOUT=180

# --- Packing small items into one call (planner ruling 23) -----------------
# An apply_to_each step whose calls go to a cloud model sends up to this many
# small items in one call (the rules and the step's text once, then the items),
# and still stores one result per item. 0 or 1 turns packing off: one call per
# item, requests byte-identical to before. Calls to a model on this machine
# are never packed. Set 0 for documents from untrusted senders: in a pack, one
# document's text could steer the answers for the others. A value that is not
# a whole number turns packing off with warning BRT-APE-007.
BORG_PACK_MAX_ITEMS=20

# --- Capability scorer ("Get Model Info" button) -------------------------
# The LLM that does web research and assigns relative task scores.
# Must be web-search-enabled — e.g. Perplexity Sonar, GPT-4o web-search,
# or Gemini with search grounding.
SCORING_MODEL=perplexity/sonar-pro-search
# Full chat-completions URL. Default points at OpenRouter, which proxies
# most search-enabled models.
SCORING_MODEL_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# --- Web search tool (BRT-WEB-01) ---------------------------------------
# Primary provider. If absent, the web_search tool silently falls back to
# Perplexity (via OpenRouter) and logs BRT-TOOL-DEGRADED once per process.
TAVILY_API_KEY=

# Default result cap. Clamped to [1..20] at runtime; the orchestrator can
# override per call via tool_requests[].args.max_results.
BORG_WEB_SEARCH_MAX_RESULTS=5

# Per-provider HTTP timeout for web_search calls.
BORG_WEB_SEARCH_TIMEOUT_SEC=8

# Explicit provider order (comma-separated, lowercase names). Default is
# `tavily,perplexity`. Set to `perplexity,tavily` to flip, or
# `perplexity` to skip Tavily entirely.
# BORG_WEB_SEARCH_PROVIDER_ORDER=tavily,perplexity

# Perplexity model routed through OpenRouter for the web_search fallback.
# Default is `perplexity/sonar`; swap to `perplexity/sonar-pro` or
# `perplexity/sonar-reasoning` for larger queries. Override without redeploy.
# BORG_PERPLEXITY_MODEL=perplexity/sonar

# --- Streaming -----------------------------------------------------------
# How often (seconds) to emit SSE keepalive comments while orchestrate_run
# is churning through a multi-node plan. Browsers time out SSE fetches
# that go silent too long; 5s is comfortably under every major browser's
# default. The value must be positive; 0 does not turn heartbeats off.
BORG_STREAM_HEARTBEAT_SEC=5

# --- Rule Zero shortcut --------------------------------------------------
# When true (default), short conversational prompts (< 500 chars, no list
# markers, no "for each"/"classify these" phrases, no live-data words like
# "latest" or "news") skip plan/re_plan and
# go straight to compose — one orchestrator call instead of three. Set to
# `false` to force the full plan path for every prompt (debugging only).
# Admin UI / /config can also write the `rule_zero_shortcut` key which
# takes precedence over this env var.
BORG_RULE_ZERO_SHORTCUT=true

# --- Local model servers (by address) --------------------------------------
# Where discovery looks for local models. Defaults reproduce the built-in
# behaviour; set these to probe another machine or port. Entries must start
# with http:// or https://; malformed entries are ignored with a warning.
# LM Studio servers, comma-separated (default: localhost ports 1234-1237).
# LMSTUDIO_BASE_URLS=http://localhost:1234,http://localhost:1235,http://localhost:1236,http://localhost:1237
# Ollama server (default http://localhost:11434, e.g. Ollama running in Docker).
# OLLAMA_BASE_URL=http://localhost:11434
# Any other OpenAI-compatible server (vLLM, llama.cpp, ...), comma-separated,
# discovered through its /v1/models. Rows appear with source "custom_key".
# LOCAL_OPENAI_BASE_URLS=

# --- On-premise lane (docs/design/on_premise_lane.md) -------------------------
# Hosts that count as "this machine" besides localhost/127.x/[::1]: names, IPs
# or CIDR ranges, comma-separated. Private addresses are NOT local unless
# listed here. In Docker, list the model server's service name (e.g. ollama).
# BORG_LOCAL_HOSTS=
# The one folder documents may be read from. Unset = any request with
# documents is refused (BRT-LANE-001). Not ".", not the app folder.
# BORG_DOCS_ROOT=C:\path\to\documents
# Lane mode: off | raw_local | all_local | by_reference (config key lane_mode wins).
# by_reference hands documents over the same way, but any ticked model (cloud
# included) may read them and the copy checks do not block: no privacy promise.
# BORG_LANE_MODE=off
# Longest output a local step reading documents may pass on (chars).
# BORG_LANE_MAX_OUTPUT_CHARS=1500
# Longest passage copied from a document that may be passed on or sent out.
# BORG_LANE_MAX_VERBATIM_CHARS=120
# Share of a document's word 8-grams a cloud request may hold.
# BORG_LANE_MAX_NGRAM_SHARE=0.10
# names | ids (ids: the planner sees no file names).
# BORG_LANE_MANIFEST=names
# Model ids and/or host:port that count as local; empty = every local address.
# BORG_LANE_LOCAL_ALLOWLIST=
# A document longer than this many characters is split into parts.
# BORG_LANE_PART_CHARS=8000

# --- Admin lock -----------------------------------------------------------
# Token that guards every admin route (keys, settings, rules, models, skills,
# logs, logs/entities, logs/export), the outbound request bodies and, while the
# on-premise lane is on, the event text in run detail.
# Sent as "Authorization: Bearer <token>"; the Admin pages ask for it once per
# browser tab. Leave it empty and only this computer (loopback) may use the
# admin routes; any other address is refused. Choose a long random value.
# ASCII only: letters, digits and punctuation, no spaces or accents. Any other
# character is reported as misconfigured (BRT-API-047) and locks the admin routes.
# Set it whenever this app can be reached from another machine.
# BORG_ADMIN_TOKEN=

# --- Replay demo (work order 4.5) ----------------------------------------
# replay: the server only plays recorded demo runs (demo/runs/*.json, written by
# scripts/export_run.py). Ask offers the recorded prompts as buttons; every route
# that changes state, and every route that could read a key or call out, returns
# 403 (BRT-RPL-001); no model, key, database or network is used. Empty or off:
# the normal app. Any other value is treated as replay (fails closed, BRT-RPL-005).
# BORG_DEMO_MODE=
# Folder holding the replay files (default demo/runs).
# BORG_REPLAY_DIR=
# Playback speed: recorded times are divided by this (1 = recorded speed;
# 0.1 to 100000). A request may send its own "replay_speed". Unset: each run
# plays in at most 60 seconds (speed = max(1, recorded seconds / 60)).
# BORG_REPLAY_SPEED=
# Docker: compose.yaml sets BORG_DEMO_MODE=replay itself; compose.live.yaml reads this file
# and sets BORG_DEMO_MODE=off. See docs/install-guide.md, "Docker".

# --- Not environment variables --------------------------------------------
# Pinning the planner (config keys `orchestrator_endpoint` and
# `orchestrator_model_name`) is done on the Admin Settings page, not here: the
# engine reads those two from the config table only. Provider keys other than
# the ones above are not read by the engine.
